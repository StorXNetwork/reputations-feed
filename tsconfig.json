{
  "compilerOptions": {
    "resolveJsonModule": true,
    "target": "es2019",                  /* Node 12 supports up to ES2019 */
    "module": "commonjs",                
    "outDir": "./build",                 
    "rootDir": "./src",                  

    /* Strict type checking */
    "strict": true,
    "esModuleInterop": true,             
    "skipLibCheck": true,                /* Avoid errors from incompatible type defs */
    "forceConsistentCasingInFileNames": true,

    /* Fix for Node.js 12 types */
    "typeRoots": ["./src/types", "./node_modules/@types"],

    /* Map newer 'node:' imports back to legacy style */
    "baseUrl": ".",
"paths": {
  "node:stream": ["./node_modules/@types/node/stream"],
  "node:events": ["./node_modules/@types/node/events"],
  "node:fs": ["./node_modules/@types/node/fs"],
  "node:path": ["./node_modules/@types/node/path"]

    }
  }
}
